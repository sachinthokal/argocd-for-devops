# Kubernetes Native Secret Definition
# -----------------------------------------------------------------------------
# NOTE: This file is an EXAMPLE template for reference/development purposes.
# In a true Production environment, NEVER commit raw/plain-text secrets directly 
# to a Git repository. Use HashiCorp Vault, Sealed Secrets, or CSI Driver instead.
###############################################################################

apiVersion: v1
kind: Secret
metadata:
  name: stel-db-secrets
  namespace: stel-ns
  labels:
    app.kubernetes.io/name: telecom-app
    app.kubernetes.io/managed-by: terraform-or-argocd
type: Opaque

# Using 'stringData' allows plain-text input (Kubernetes automatically Base64 encodes it upon creation)
stringData:
  # ===========================================================================
  # 1. APPLICATION ENVIRONMENT VARIABLES (Spring Boot Backend)
  # ===========================================================================
  # FQDN is used to prevent UnknownHostException across cluster namespaces
  DB_URL: "jdbc:postgresql://postgres-service.stel-ns.svc.cluster.local:5432/stelcom_db"
  DB_DRIVER: "org.postgresql.Driver"
  
  # API Key for Gateway Authentication
  GATEWAY_API_KEY: "stelcom-secret-key-9988"

  # ===========================================================================
  # 2. DATABASE CREDENTIALS (PostgreSQL StatefulSet / Pods)
  # ===========================================================================
  DB_NAME: "stelcom_db"
  DB_USER: "stelcom_admin"
  DB_PASSWORD: "StelcomSecurePass2026"